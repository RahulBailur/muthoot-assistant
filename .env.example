# Core
ENVIRONMENT=development                    # development | test | demo
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRY_HOURS=12
MONGO_URI=mongodb://mongo:27017/goldloan
REDIS_URL=redis://redis:6379/0
USE_MOCK_DB=false

# Seed data — password given to every seeded branch staff and admin account
SEED_DEFAULT_PASSWORD=

# Mock OTP. There is no SMS gateway in the demo, so the code comes back in the API response.
OTP_TTL_S=300
OTP_MAX_ATTEMPTS=5
OTP_REVEAL_IN_RESPONSE=true

# Gold loan values (mock; replace with the client's figures)
GOLD_RATE_24K_PER_GRAM=12500               # rupees; admin can override today's rate in the app
LTV_LIMIT=0.75                             # loan-to-value cap
ESTIMATE_DEDUCTION=0.10                    # stones/wastage found at valuation can lower the value
AUCTION_GRACE_DAYS=30                      # days after maturity before an auction notice

# Rate limits
RATE_LIMIT_AUTH=10/minute

# LLM (M2). The first choice; the other real provider stands behind it, then rule-based replies.
# mock = no model at all: the assistant answers from rules only (the estimate still works).
LLM_PROVIDER=gemini                        # gemini | ollama | mock
LLM_TIMEOUT_S=8                            # slower than this counts as failed; the next tier answers
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=                         # current free Flash-Lite model ID
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=                              # e.g. qwen2.5:1.5b; empty = no local tier
# Failover: after this many failures in a row a provider is skipped for the cool-down
GEMINI_BREAKER_THRESHOLD=3
GEMINI_BREAKER_COOLDOWN_S=60
RESPONSE_CACHE_TTL_S=3600
RATE_LIMIT_CHAT=20/minute

# Intent classifier: needs `pip install -e ".[ml]"`; leave empty for keyword rules only
INTENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Voice (M3)
GNANI_API_KEY=                             # the client's Gnani (Vachana) key: STT and TTS
